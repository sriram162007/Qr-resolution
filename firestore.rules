rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read and write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Organizations - read/write for authenticated users (admin only)
    match /organizations/{organizationId} {
      allow read, write: if request.auth != null;
    }
    
    // Locations - public read for issue reporting, authenticated write
    match /locations/{locationId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // QR Codes - public read for scanning, authenticated write
    match /qr_codes/{qrId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Tickets - public create and read by ticketId, authenticated write
    match /tickets/{ticketId} {
      allow list: if request.auth != null;
      allow get: if true;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }
    
    // Ticket updates - public create, authenticated read/write
    match /ticket_updates/{updateId} {
      allow list, get: if request.auth != null;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }
    
    // Lock down everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
