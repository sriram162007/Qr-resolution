rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users - authenticated users can read all profiles for admin features,
    // users can write their own profile
    match /users/{userId} {
      allow list, get: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Organizations - public read for QR resolution, authenticated write
    match /organizations/{organizationId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Locations - public read for QR resolution, authenticated write
    match /locations/{locationId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // QR Codes - public read by ID, authenticated write
    match /qr_codes/{qrId} {
      allow get: if true;
      allow list, create, update, delete: if request.auth != null;
    }
    
    // Tickets - public create and read by ticketId, authenticated write
    match /tickets/{ticketId} {
      allow list: if request.auth != null;
      allow get: if true;
      allow create: if true;
      allow update, delete: if request.auth != null;
      
      // Activity history - authenticated write only
      match /activity/{activityId} {
        allow list, get: if request.auth != null;
        allow create, update, delete: if request.auth != null;
      }
    }
    
    // Ticket updates - public create, authenticated read/write
    match /ticket_updates/{updateId} {
      allow list, get: if request.auth != null;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }
    
    // Lock down everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
