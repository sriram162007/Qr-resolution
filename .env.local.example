VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_APP_URL=http://localhost:5173

# Gemini AI (server-side only — do NOT prefix with VITE_)
GEMINI_API_KEY=

# Supabase — used for photo storage. Get these from your Supabase project settings.
# URL: Settings → API → Project URL
# Key: Settings → API → Project API keys → anon / public
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Twilio WhatsApp (server-side only — do NOT prefix with VITE_)
# Account SID and Auth Token from twilio.com/console
# TWILIO_WHATSAPP_FROM must be the sandbox number: whatsapp:+14155238886
# NOTE: sandbox recipients must opt-in by sending "join <word>" to +14155238886 first.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Firebase Admin SDK (Server-side / Vercel API routes — do NOT prefix with VITE_)
# Get service account credentials from: Firebase Console → Project Settings → Service accounts
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# SLA Cron Secret (for Vercel Cron or authenticated SLA monitor calls)
CRON_SECRET=your-secure-random-cron-secret-token

# Admin notification phone number for Level 2 escalations (E.164 format, e.g., +919876543210)
ADMIN_ESCALATION_PHONE=

